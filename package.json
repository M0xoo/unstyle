{
  "name": "@m0xoo/unstyle",
  "version": "2.0.0",
  "description": "An agent skill that takes the default out of AI-made design, plus a zero-dependency scanner for the tells.",
  "type": "module",
  "bin": {
    "unstyle": "skills/unstyle/scripts/scan.mjs"
  },
  "files": [
    "skills/",
    ".claude-plugin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test skills/unstyle/scripts/scan.test.mjs",
    "scan": "node skills/unstyle/scripts/scan.mjs",
    "scan:examples": "node skills/unstyle/scripts/scan.mjs examples/after.html examples/index.html"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["agent-skill", "claude-code", "skill", "design", "frontend", "ai-slop", "lint", "tailwind"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M0xoo/unstyle.git"
  },
  "author": "M0xoo",
  "license": "ISC"
}
